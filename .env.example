# Public site URL, used for canonical links, Open Graph, sitemap and JSON-LD.
VITE_SITE_URL=https://solarfeedhubs.com

# Supabase project (Project settings → API). The anon key is safe to expose:
# row-level security only allows inserts into partner_enquiries and reads of published pilot_posts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
